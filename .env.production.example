# Copy this file to .env (dev) or .env.production (build) and fill in the values.

# ── X sign-in gate ────────────────────────────────────────────────────
# The app is gated: nobody plays without a verified X account. The gate
# lives in api/ (Vercel functions) — the game origin is whatever serves
# the build (itch iframe, vercel, localhost all work).
#   VITE_API_URL = the ORIGIN of the api deployment, no path.
# Unset = gate opens silently (local dev convenience).
VITE_API_URL=https://your-icenwater-api.vercel.app

# ── api/ function envs (set on the Vercel project, NOT in .env here) ──
# X_CLIENT_ID=            developer.x.com app, type "Web App",
#                         callback <api-origin>/api/auth/x/callback
# X_CLIENT_SECRET=        optional — public clients skip it (PKCE alone)
# SESSION_SECRET=         random 32+ bytes — signs session tokens AND
#                         colyseus room tickets. REQUIRED in prod.
# X_ALLOWED_ORIGINS=      extra game origins beyond the built-in
#                         *.itch.io / *.itch.zone / localhost allowlist
#                         (comma-separated, e.g. your custom domain)
# UPSTASH_REST_URL=       leaderboard storage
# UPSTASH_REST_TOKEN=
# FLOVIA_KEY=             flovia agent tooling — X-post / web / onchain
#                         lookups + image gen. NOT the player auth (the
#                         X OAuth gate above signs players in). For
#                         server-side missions + agent work on the repo.
#                         Personal quota — every call bills the owner.

# Leaderboard — the Cloudflare Worker proxy (worker/ folder). Preferred:
# no secrets ship in the game JS.
VITE_BOARD_URL=https://icenwater-board.your-account.workers.dev

# Alternative: direct Upstash (token IS visible in the bundle — dev only)
# VITE_UPSTASH_REST_URL=https://your-db-12345.upstash.io
# VITE_UPSTASH_REST_TOKEN=your-rest-token

# Online multiplayer — your deployed Colyseus server URL (Render/Fly).
# wss:// is derived automatically. Leave unset until multiplayer is deployed.
VITE_SERVER_URL=https://your-server-name.onrender.com

# ── game server envs (set on the server host, NOT in .env here) ───────
# SESSION_SECRET=         SAME value as the api's — verifies room
#                         tickets. Prod without it rejects every join.
