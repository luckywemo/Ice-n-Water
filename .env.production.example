# Copy this file to .env (dev) or .env.production (build) and fill in the values.

# Leaderboard — the Cloudflare Worker proxy (worker/ folder). Preferred:
# no secrets ship in the game JS.
VITE_BOARD_URL=https://icenwater-board.your-account.workers.dev

# Alternative: direct Upstash (token IS visible in the bundle — dev only)
# VITE_UPSTASH_REST_URL=https://your-db-12345.upstash.io
# VITE_UPSTASH_REST_TOKEN=your-rest-token

# Online multiplayer — your deployed Colyseus server URL (Render/Fly).
# wss:// is derived automatically. Leave unset until multiplayer is deployed.
VITE_SERVER_URL=https://your-server-name.onrender.com
